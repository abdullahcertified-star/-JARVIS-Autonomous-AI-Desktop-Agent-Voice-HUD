# Gemini API Key: Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
JARVIS_GEMINI_MODEL=gemini-flash-lite-latest

# Speech Synthesis (TTS) Engine: 'edge-tts' (free, unlimited) or 'gemini-3.8-flash-tts'
GEMINI_TTS_MODEL=edge-tts
GEMINI_TTS_VOICE=Algenib

# Edge Neural TTS Voice (Deep Movie / Anime Cinematic Voice):
# Options: 'en-US-ChristopherNeural' (Deep Cinematic), 'en-GB-ThomasNeural', 'en-GB-RyanNeural'
JARVIS_EDGE_VOICE=en-US-ChristopherNeural
JARVIS_EDGE_PITCH=-4Hz
JARVIS_EDGE_RATE=-2%
JARVIS_COMMA_PAUSE_SEC=0.7
JARVIS_PERIOD_PAUSE_SEC=1.0
JARVIS_AI_SPEECH_CORRECTION=true

# Speech Recognition (STT): 'speech_recognition' (Google STT) or 'whisper'
JARVIS_STT_ENGINE=speech_recognition
JARVIS_WHISPER_MODEL=base.en
JARVIS_WHISPER_CPU_THREADS=2

# Voice Timing & Ambient Noise Calibration:
JARVIS_WAKE_WORD_MODEL=hey_jarvis
JARVIS_WAKE_WORD_THRESHOLD=0.08
JARVIS_INPUT_DEVICE=
JARVIS_SILENCE_RMS=300
JARVIS_SPEECH_START_TIMEOUT=4.0
JARVIS_MAX_RECORD_SECONDS=30.0
JARVIS_SILENCE_DURATION=2.5
JARVIS_AMBIENT_CALIBRATE_SEC=1.0
JARVIS_CONVERSATION_TIMEOUT=45.0

# Cinematic Sound Effects (Marvel HUD audio cues)
JARVIS_SFX_ENABLED=true
JARVIS_SFX_VOLUME=0.45

# Voice Interruption & Barge-In
JARVIS_BARGE_IN_ENABLED=true
JARVIS_BARGE_IN_ENERGY_RATIO=3.0
JARVIS_BARGE_IN_GRACE_PERIOD=0.25

# Proactive Desktop Background Watcher
JARVIS_WATCHER_ENABLED=true
JARVIS_WATCHER_CHECK_INTERVAL_SEC=30.0
JARVIS_WATCHER_COOLDOWN_SEC=300.0
JARVIS_WATCHER_RAM_THRESHOLD_PERCENT=90.0
JARVIS_WATCHER_DISK_MIN_GB=10.0
JARVIS_WATCHER_CPU_THRESHOLD_PERCENT=95.0
JARVIS_WATCHER_BATTERY_MIN_PERCENT=15.0


